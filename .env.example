# lab-cloud-manager settings.
#
#   cp .env.example .env
#
# docker compose reads .env automatically. Every value below has a
# working default, so an empty file — or no file at all — is fine.
#
# This is the app itself, not your lab. Hypervisors, DNS providers,
# database servers, authentik, UniFi and single sign-on are added in the
# UI once the console is up, where the credentials are checked before
# they're stored.

# --- The first account -------------------------------------------------
# Seeded on the FIRST RUN ONLY. After that, accounts live in
# IAM & Admin and these are ignored.
#
# Leave the password empty and one is generated and written to the log
# exactly once at startup — the only time this app logs a password, and
# better than a default everyone knows.
LCM_AUTH_BOOTSTRAP_EMAIL=lab@localhost
LCM_AUTH_BOOTSTRAP_PASSWORD=

# --- The browser terminal ----------------------------------------------
# Create the console's login on a guest that has never seen its key,
# through the hypervisor's guest agent, so Connect works on VMs this
# console adopted rather than created. Only ever runs after an
# authentication failure. Needs VM.Monitor on the Proxmox token.
LCM_SSH_PROVISION=true

# Give that account passwordless sudo. Off on purpose: creating a login
# is implied by clicking Connect, granting root across the lab is not.
LCM_SSH_PROVISION_SUDO=false

# --- Reaching it from outside the lab ----------------------------------
# A Cloudflare Tunnel, so the console is published without opening a
# port or holding a certificate. Only used by `make tunnel`.
#
#   Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel
#   → Docker → copy the token out of the command it shows you
#   → Public hostname: your name, service http://app:8080
#
# Then put a policy in front of it under Zero Trust → Access. This
# console holds credentials for every backend in your lab and can open
# a root-capable shell on your guests — it should not be a URL anyone
# can reach.
TUNNEL_TOKEN=

# --- Serving -----------------------------------------------------------
# Set by the images already; override only if you know you need to.
# LCM_LISTEN=0.0.0.0:8080
# LCM_DB_DRIVER=sqlite
# LCM_DB_DSN=/data/labcloud.db
# LCM_STATIC_DIR=/app/static
