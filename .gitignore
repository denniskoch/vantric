# Settings, and possibly the first account's password
.env

# Local databases — `make dev` writes backend/vantric.db,
# `make up` writes data/vantric.db
*.db
*.db-shm
*.db-wal

# Uploaded agent installers — runtime data, not source. `make dev`
# writes backend/installers, the container writes data/installers, and
# a fleetd package contains your enrollment secret, so these must never
# be committed.
backend/installers/
data/installers/

# Uploaded shortcut icons — same story, one directory over.
backend/shortcut-icons/
data/shortcut-icons/

# Go
backend/server

# Node
node_modules/
frontend/dist/

# macOS folder metadata. One of these was committed once and is the
# reason this section exists — Finder writes them into any directory it
# has been asked to display.
.DS_Store
._*
.Spotlight-V100
.Trashes

# Claude Code session state
.claude/scheduled_tasks.lock
