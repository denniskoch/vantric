# Settings, and possibly the first account's password
.env

# Local databases — `make dev` writes backend/labcloud.db,
# `make up` writes data/labcloud.db
*.db
*.db-shm
*.db-wal

# Uploaded agent installers — runtime data, not source. `make dev`
# writes backend/installers, the container writes data/installers, and
# a fleetd package contains your enrollment secret, so these must never
# be committed.
backend/installers/
data/installers/

# Go
backend/server

# Node
node_modules/
frontend/dist/

# Claude Code session state
.claude/scheduled_tasks.lock
